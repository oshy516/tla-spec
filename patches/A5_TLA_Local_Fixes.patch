diff --git a/third_party/ascend/unittest/tla_ut/test_pr_integration_api.py b/third_party/ascend/unittest/tla_ut/test_pr_integration_api.py
new file mode 100644
index 000000000..119e17436
--- /dev/null
+++ b/third_party/ascend/unittest/tla_ut/test_pr_integration_api.py
@@ -0,0 +1,47 @@
+"""Check cross-PR caller compatibility without loading a native extension.
+
+This is a source-level regression, not an IR or device execution test.
+"""
+import ast
+from pathlib import Path
+import unittest
+
+
+UT = Path(__file__).resolve().parent
+TLA = UT.parents[1] / "language" / "tla"
+
+
+class PRIntegrationAPI(unittest.TestCase):
+    def test_mmad_fixpipe_keywords_match_public_configuration(self):
+        definitions = ast.parse((TLA / "dma.py").read_text())
+        fields = {
+            node.name: {field.target.id for field in node.body if isinstance(field, ast.AnnAssign)}
+            for node in definitions.body
+            if isinstance(node, ast.ClassDef) and node.name.startswith("FixpipeL0C2")
+        }
+        errors = []
+        for path in sorted((UT / "cube").glob("mmad_l0*.py")):
+            for call in ast.walk(ast.parse(path.read_text())):
+                if isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute) and call.func.attr in fields:
+                    unknown = {kw.arg for kw in call.keywords if kw.arg is not None} - fields[call.func.attr]
+                    if unknown:
+                        errors.append(f"{path.name}:{call.lineno}: {call.func.attr}: {sorted(unknown)}")
+        self.assertEqual(errors, [], "\n".join(errors))
+
+    def test_dma_views_use_current_public_signature(self):
+        definition = next(node for node in ast.parse((TLA / "view.py").read_text()).body
+                          if isinstance(node, ast.FunctionDef) and node.name == "view")
+        allowed = {arg.arg for arg in definition.args.args + definition.args.kwonlyargs}
+        errors = []
+        for call in ast.walk(ast.parse((UT / "dma/copy.py").read_text())):
+            if (isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute)
+                    and isinstance(call.func.value, ast.Name) and call.func.value.id == "tla"
+                    and call.func.attr == "view"):
+                unknown = {kw.arg for kw in call.keywords if kw.arg is not None} - allowed
+                if unknown:
+                    errors.append(f"copy.py:{call.lineno}: {sorted(unknown)}")
+        self.assertEqual(errors, [], "\n".join(errors))
+
+
+if __name__ == "__main__":
+    unittest.main()
